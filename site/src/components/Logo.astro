---
// The site's mark: the launcher's moving braille logo and the name in the
// brand gradient. The name comes from the site's title (internal/brand).
import { logo } from '../scripts/logo.js';
const name = Astro.locals.starlightRoute?.siteTitle ?? '';
---

<a class="site-logo" href={import.meta.env.BASE_URL} aria-label={`${name}, home`}>
	<span class="mark" data-logo aria-hidden="true">{logo(0)}</span>
	<span class="name">{name}</span>
</a>

<style>
	.site-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		font-family: var(--sl-font-mono);
		font-weight: 700;
		font-size: 1.0625rem;
		white-space: nowrap;
	}
	.mark {
		color: var(--site-brand-b);
		letter-spacing: -0.05em;
	}
	.name {
		background: linear-gradient(90deg, var(--site-brand-a), var(--site-brand-b));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
