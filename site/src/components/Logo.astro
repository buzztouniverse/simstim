---
// The site's mark: a small orange square and the name. The name comes from
// the site's title (internal/brand).
const name = Astro.locals.starlightRoute?.siteTitle ?? '';
---

<a class="site-logo" href={import.meta.env.BASE_URL} aria-label={`${name}, home`}>
	<span class="mark" aria-hidden="true"></span>
	<span class="name">{name}</span>
</a>

<style>
	.site-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--sl-color-white);
		text-decoration: none;
		font-family: var(--site-display);
		font-weight: 620;
		font-size: 1.1875rem;
		letter-spacing: -0.025em;
		white-space: nowrap;
	}
	.mark {
		width: 0.625rem;
		height: 0.625rem;
		background: var(--site-orange);
	}
</style>
