---
// Your machines, your SSH: your laptop, linked by your own SSH to any
// Linux host. A still line drawing in the hero's style; a wide version, and
// a tall one for phones.
const hosts = ['a VPS', 'a cloud VM', 'a box at home'];
---

<div class="hosts" role="img" aria-label="Your laptop, linked by your own SSH to a VPS, a cloud VM and a box at home.">
	<svg class="wide" viewBox="0 0 700 400" aria-hidden="true" focusable="false">
		<rect class="box" x="16" y="160" width="150" height="92" rx="5"></rect>
		<rect class="box" x="4" y="252" width="174" height="10" rx="3"></rect>
		<path class="wire" d="M166 206H300"></path>
		<text class="tx" x="233" y="194" text-anchor="middle">[ ssh ]</text>
		{
			hosts.map((h, i) => {
				const y = 24 + i * 128;
				return (
					<g>
						<path class="wire" d={`M300 206V${y + 48}H420`} />
						<rect class="node" x="351" y={y + 43} width="10" height="10" />
						<rect class="box" x="420" y={y} width="264" height="96" rx="6" />
						<text class="tx ink" x="438" y={y + 28}>{`[ ${h} ]`}</text>
						<rect class="fill" x="438" y={y + 46} width="132" height="9" />
						<rect class="track" x="438" y={y + 66} width="96" height="9" />
					</g>
				);
			})
		}
	</svg>
	<svg class="tall" viewBox="0 0 360 470" aria-hidden="true" focusable="false">
		<rect class="box" x="110" y="12" width="140" height="84" rx="5"></rect>
		<rect class="box" x="98" y="96" width="164" height="10" rx="3"></rect>
		<path class="wire" d={`M180 106V130H36V${150 + 2 * 110 + 40}`}></path>
		<text class="tx" x="196" y="124">[ ssh ]</text>
		{
			hosts.map((h, i) => {
				const y = 150 + i * 110;
				return (
					<g>
						<path class="wire" d={`M36 ${y + 40}H80`} />
						<rect class="node" x="53" y={y + 35} width="10" height="10" />
						<rect class="box" x="80" y={y} width="264" height="84" rx="6" />
						<text class="tx ink" x="98" y={y + 28}>{`[ ${h} ]`}</text>
						<rect class="fill" x="98" y={y + 44} width="132" height="9" />
						<rect class="track" x="98" y={y + 62} width="96" height="9" />
					</g>
				);
			})
		}
	</svg>
</div>

<style>
	.hosts svg {
		display: block;
		width: 100%;
		height: auto;
		margin-inline: auto;
		overflow: visible;
	}
	.wide {
		max-width: 50rem;
		aspect-ratio: 700 / 400;
	}
	.tall {
		display: none !important;
		max-width: 24rem;
		margin-inline: auto;
		aspect-ratio: 360 / 470;
	}
	@media (max-width: 40rem) {
		.wide {
			display: none !important;
		}
		.tall {
			display: block !important;
		}
	}
	.box {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.wire {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.node,
	.fill {
		fill: var(--site-orange);
	}
	.track {
		fill: var(--sl-color-gray-5);
	}
	.tx {
		font-family: var(--sl-font-mono);
		font-size: 15px;
		fill: var(--sl-color-gray-3);
	}
	.tx.ink {
		fill: var(--sl-color-white);
	}
</style>
