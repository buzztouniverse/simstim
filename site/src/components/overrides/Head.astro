---
// Starlight's head, plus the site's own: a mark that script runs (the
// hero's story waits for it before it plays), the fonts, preloaded, and the
// bar colour on phones. Every file is the site's own: no request goes to
// anyone else.
import Default from '@astrojs/starlight/components/Head.astro';
const base = import.meta.env.BASE_URL;
---

<Default />
<script is:inline>
	document.documentElement.dataset.js = '';
</script>
<link rel="preload" href={`${base}fonts/sans.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${base}fonts/display.woff2`} as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#111215" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#FBFBFA" media="(prefers-color-scheme: light)" />
